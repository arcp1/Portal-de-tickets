.env
.env.local
.env.*.local
# Los respaldos del .env traen el JWT_SECRET y la contraseña de la base.
.env.respaldo-*
# Lo que deja scripts/respaldo.sh por omisión: el volcado de la base trae los
# hashes de contraseña y los datos personales del padrón.
/respaldos/
# Reportes de pentest: traen vectores de explotación, riesgos abiertos y
# direcciones internas. Se guardan fuera de git.
/REPORTE-PENTEST*.md
nginx/certs/*.key
nginx/certs/*.crt
*.pem
*.key
/data/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
node_modules/
dist/
build/
.venv/
venv/
ENV/

# Copias de trabajo temporales de las herramientas de desarrollo.
.claude/worktrees/
