# Database Configuration
POSTGRES_USER=cgr_user
# Invente una y pongala tambien dentro de DATABASE_URL, ahi codificada.
POSTGRES_PASSWORD=CAMBIAR_ESTA_CONTRASENA
POSTGRES_DB=portal_tickets
# Estas dos NO las lee nadie: ni el backend ni docker-compose. La direccion
# real de la base vive dentro de DATABASE_URL, aqui abajo. Se dejan porque es
# la convencion de Postgres y alguien las buscara, pero cambiar el puerto aqui
# no mueve nada: hay que cambiarlo en DATABASE_URL.
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Si la contrasena lleva @ / * : # ? & hay que escribirlos codificados
# (@ = %40, / = %2F, * = %2A). Sin eso, la conexion falla.
DATABASE_URL=postgresql://cgr_user:CAMBIAR_ESTA_CONTRASENA@db:5432/portal_tickets

# Security & JWT
# ESTO NO ES OPCIONAL. JWT_SECRET es lo unico que separa una sesion legitima de
# una falsificada: quien lo conozca se firma un token de administrador. El valor
# de abajo esta en el repositorio, asi que vale tanto como no tener secreto.
# Genere el suyo con:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Con ENVIRONMENT distinto de development, el backend se niega a arrancar si
# detecta uno de los valores de ejemplo.
# Generela con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# El portal se niega a arrancar en produccion con un valor de ejemplo.
JWT_SECRET=GENERAR_UNA_CLAVE_ALEATORIA
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Origenes del navegador que pueden llamar a la API.
#
# El portal y la API se sirven desde el mismo NGINX, asi que para el uso normal
# el navegador no necesita CORS y esto no hace falta tocarlo. Importa en dos
# casos: el Vite de desarrollo, que corre en el 3000 y si es otro origen; y una
# URL publica distinta —un Tailscale Funnel, por ejemplo—, que hay que anadir
# aqui o el navegador rechazara las llamadas.
#
# Separados por comas, sin espacios, con el esquema y el puerto incluidos.
# Nunca poner `*`: con credenciales el propio estandar lo prohibe y los
# navegadores lo rechazan.
ORIGENES_PERMITIDOS=http://localhost:3000,http://127.0.0.1:3000

# Environment
# Tambien decide si el API publica su documentacion interactiva (/docs, /redoc
# y /openapi.json): solo con development, desarrollo, dev o local. En
# produccion, o si falta la variable, quedan cerradas.
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI Integration Services (Phase 2 & 3 Placeholders)
# Dentro de compose, Ollama es un servicio vecino.
OLLAMA_HOST=http://ollama:11434

# --- Gemini (Fase 3) ---
# La llave se saca en https://aistudio.google.com/apikey y se pega AQUI.
# Nunca en el repositorio, nunca en un chat, nunca en un correo: quien la tenga
# gasta con la tarjeta de la empresa. Si se filtra, se revoca desde ahi mismo.
#
# OJO: la suscripcion de Google One / Gemini Pro NO incluye uso de la API. Son
# dos productos distintos; la API se factura aparte por proyecto de Google Cloud.
#
# Sin llave el portal funciona igual: Ollama se queda con todo.
GEMINI_API_KEY=
# Interruptor aparte de la llave, para apagarlo sin borrarla.
GEMINI_HABILITADO=true
# Flash es el que corresponde a este uso. Pro cuesta varias veces mas y no
# aporta en respuestas cortas sobre extractos ya recuperados.
GEMINI_MODELO=gemini-3.6-flash
GEMINI_TIMEOUT=20
# Cada extracto cuesta tokens de entrada. Cinco alcanzan y el gasto es predecible.
GEMINI_MAX_EXTRACTOS=5
GEMINI_MAX_TOKENS_RESPUESTA=600
GEMINI_MAX_TOKENS_RESUMEN=500
GEMINI_ESPERA_CUOTA=60

# --- Fase 2: asistente local (Ollama) ---
# En false el portal funciona igual, solo sin ayudas de IA.
IA_HABILITADA=true
OLLAMA_MODELO_EMBEDDING=nomic-embed-text
OLLAMA_MODELO_TEXTO=qwen2.5:3b
# Si se rebasan, se abandona la operacion y el flujo continua sin ella.
# Generoso a proposito: la normalizacion ya no bloquea la creacion del ticket,
# corre por detras despues de entregar el folio. Con 10 s se pasaba de largo y
# fallaba en CADA ticket, en silencio.
OLLAMA_TIMEOUT_NORMALIZACION=25
OLLAMA_TIMEOUT_EMBEDDING=5

# Cuantos hilos usa el modelo de texto. Cuatro, y no son pocos: son los rapidos.
# Ollama reparte por defecto entre los ocho nucleos y en esta maquina eso hunde
# la lectura del prompt —62.9 tokens/s con cuatro hilos contra 10.0 con ocho—.
# De punta a punta: clasificar pasa de 2.78 s a 0.95 s.
# Solo afecta al modelo de texto; en los embeddings el reparto por defecto gana.
# Si se cambia de maquina o de modelo, hay que volver a medirlo.
OLLAMA_HILOS_TEXTO=4
# Tareas de una sola vez con alguien esperando (proponer el mapeo de
# columnas de un archivo de RH). Aguanta mas: si el modelo estaba
# dormido, la primera respuesta paga la carga.
OLLAMA_TIMEOUT_ASISTENCIA=30

# Base de conocimiento
# Umbral de similitud coseno. Se calibra con veces_util / veces_sugerida.
KB_UMBRAL_SIMILITUD=0.75
KB_MAX_SUGERENCIAS=3

# --- Recuperacion: de donde sale lo que el asistente "sabe" ---
# Ni Ollama ni Gemini conocen esta planta. Lo que responden sale de los tickets
# ya resueltos y de la documentacion de TI; estos parametros gobiernan eso.
RECUPERACION_MAX_PASAJES=5
# Por debajo de esto no se considera parecido. Si no queda ningun pasaje, NO se
# le pregunta a ningun modelo: se dice "no tenemos nada escrito de esto". Es el
# corte que mas previene respuestas inventadas, y ademas no cuesta nada.
RECUPERACION_UMBRAL=0.62
ASISTENTE_MAX_TOKENS=400
# Cuanto peor que el mejor resultado puede ser un pasaje y aun asi mostrarse.
# Un umbral fijo no basta: medido, "me sale una linea oscura al imprimir" trae
# el ticket correcto al 69% y uno de "cuenta bloqueada" al 64%. Lo que los
# separa no es el numero absoluto, es la distancia entre ellos.
RECUPERACION_MARGEN=0.04
# Lo que se le exige a un pasaje que viene SOLO.
# El margen de arriba filtra midiendo distancias entre candidatos; con un unico
# resultado no filtra nada, y ese es el caso normal mientras la base de
# conocimiento sea pequena. Medido: "el escaner del anden 3 no manda nada al
# sistema" recupero un solo pasaje al 66% sobre una cuenta bloqueada, paso el
# umbral general por cuatro puntos y se gastaron 27 s de CPU para acabar
# entregando ruido. Va entre RECUPERACION_UMBRAL y ASISTENTE_UMBRAL_DIRECTO.
RECUPERACION_UMBRAL_SOLITARIO=0.70
# Una respuesta que solo trae la cita ("[1]") cumple la regla y no dice nada.
# El corte es contra el vacio, no contra la brevedad.
ASISTENTE_MIN_CARACTERES=15
# Que fraccion del vocabulario con contenido de la respuesta tiene que venir de
# las fuentes. Atrapa al modelo cuando se va por otro lado (habla de fusores
# cuando la nota decia rodillo). Heuristica, no demostracion.
ASISTENTE_ANCLAJE_MINIMO=0.4
# Arriba de esto la coincidencia no deja dudas y se entrega la solucion ya
# escrita, sin que ningun modelo la redacte: instantaneo, gratis y sin manera de
# que se le cambie el sentido a algo que ya estaba bien escrito.
ASISTENTE_UMBRAL_DIRECTO=0.75
# Cuanto se tienen que parecer dos pasajes para considerarlos el mismo contenido
# repetido. La misma falla reportada tres veces son tres tickets y una sola
# respuesta; sin esto se tomaban por tres fuentes distintas.
ASISTENTE_DUPLICADO_MINIMO=0.7
# Ventaja de una solucion general sobre un ticket suelto: esta escrita para
# responder la pregunta, el ticket cuenta lo que paso un dia concreto.
RECUPERACION_VENTAJA_GENERAL=0.05
# Cuanto pesa en el orden que a la gente le haya servido un pasaje.
# El portal pregunta "¿te sirvio?" desde el principio, pero esa respuesta solo
# alimentaba una metrica: la busqueda no se enteraba. Va suavizado, asi que un
# voto suelto no mueve nada; hacen falta varios. Pequeno a proposito: es una
# preferencia, no un veto. En 0 se apaga el lazo.
RECUPERACION_PESO_UTILIDAD=0.03

# --- Soluciones generales ---
# Cuantos tickets del mismo problema hacen falta para escribir un procedimiento.
# Con uno no hay patron, hay un caso.
SOLUCION_GENERAL_MIN_TICKETS=3
# Que tan parecidos tienen que ser para considerarlos el mismo problema. Alto a
# proposito: juntar cosas distintas produce procedimientos que no sirven.
SOLUCION_GENERAL_UMBRAL=0.80
SOLUCION_GENERAL_MAX_TICKETS=10
SOLUCION_GENERAL_MIN_CARACTERES=80
# Que fraccion del borrador tiene que venir de los tickets. Mas exigente que en
# el asistente: un borrador se lee una vez y se publica.
SOLUCION_GENERAL_ANCLAJE_MINIMO=0.5
# Minimo de caracteres de la solucion para poder cerrar un ticket.
SOLUCION_MIN_LONGITUD=20

# Chatbot flotante
# Debajo de este valor no se confia en la clasificacion y se piden los dropdowns.
CHAT_UMBRAL_CONFIANZA=0.7
# A la cuarta, ticket. Corta la conversacion circular.
CHAT_MAX_INTERCAMBIOS=3
# El chat si espera a esto, asi que no puede ser generoso. Medido: ~2,8 s con
# la cache del prompt caliente. Antes tardaba mas de 10 y fallaba siempre.
# 20 y no 10: medido, clasificar tarda 11-13 s cuando la llamada anterior
# llevaba otra instruccion y hay que releer el prompt entero. Con 10 ese caso
# siempre se pasaba del tiempo y el chat sacaba los desplegables.
OLLAMA_TIMEOUT_CLASIFICACION=20

# --- Horario del equipo de TI ---
# No hay personal despues de las 17:00. El portal no finge que si: le dice al
# usuario cuando lo van a atender y fuera de horario el asistente se esfuerza mas.
HORARIO_INICIO=8
HORARIO_FIN=17
DIAS_LABORALES=0,1,2,3,4
HUSO_HORARIO_OFFSET=-6
KB_MAX_SUGERENCIAS_FUERA_HORARIO=5

# --- SLA por prioridad, en horas HABILES ---
# Un ticket del viernes 16:50 con SLA de 8h vence el lunes, no el sabado.
SLA_HORAS_CRITICA=2
SLA_HORAS_ALTA=8
SLA_HORAS_MEDIA=24
SLA_HORAS_BAJA=72

# --- Adjuntos ---
ADJUNTOS_RUTA=/app/adjuntos
ADJUNTOS_MAX_MB=10
ADJUNTOS_MAX_POR_TICKET=5

# --- Catalogo visual: los problemas que se reconocen mirandolos ---
# "Mi copia sale borrosa" no se resuelve igual que "no manda a imprimir". Para
# lo primero lo util no es un parrafo: es la foto del defecto. TI la documenta y
# al usuario se le pregunta "¿se ve asi?" antes de contestarle nada.
#
# Va dentro de ADJUNTOS_RUTA a proposito: ese volumen ya existe, ya se respalda
# y ya esta montado donde el backend puede escribir.
VISUAL_RUTA=/app/adjuntos/visual
VISUAL_MAX_MB=10
VISUAL_MAX_IMAGENES=12
# Parecido minimo para ensenarle una ficha a alguien. Medido con el modelo de
# esta planta: la consulta que le toca sale al 0,80 y una de otra categoria al
# 0,58, asi que el corte va holgado en medio. Queda por encima del umbral
# general (0.62) porque una ficha esta escrita para emparejar —titulo, sintoma
# y las frases que usa la gente— mientras que un ticket cuenta lo que paso un
# dia concreto.
VISUAL_UMBRAL=0.65
VISUAL_MAX_CANDIDATAS=3
VISUAL_MARGEN=0.10

# --- Cache de vectores ---
# Cuantos embeddings ya calculados se recuerdan, para no volver a pedirle al
# modelo el mismo texto. Al escribir un ticket, tres bloques de la pantalla
# consultan por separado con la misma frase; medido aqui, cada embedding cuesta
# entre 74 y 579 ms. En 0 se apaga.
EMBEDDING_CACHE_MAX=32

# --- Avisos por correo ---
# Sin SMTP_HOST el servicio queda inactivo en silencio y el portal funciona igual.
NOTIFICACIONES_ACTIVAS=true
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=portal-tickets@cgr.mx
SMTP_STARTTLS=true
SMTP_SSL=false
# Con TLS activado, esto cambia a https://... : es la direccion que sale en
# los correos de aviso.
PORTAL_URL=http://localhost

# --- Temas recurrentes ---
# Cuantas veces debe repetirse un problema no contemplado para proponerlo
# como tema nuevo con su propio checklist.
TEMA_UMBRAL_AGRUPACION=0.78
TEMA_MIN_OCURRENCIAS=3

# --- Rendimiento de Ollama ---
# Mantiene el modelo en RAM: sin esto la primera consulta tras unos minutos
# de silencio paga la recarga completa (~9s en vez de ~800ms).
OLLAMA_KEEP_ALIVE=30m
CHAT_MIN_PALABRAS=4
CHAT_MIN_CARACTERES=20

# --- Aforo de la CPU: cuantas tareas de IA corren a la vez ---
# Aqui no hay GPU. La generacion de qwen2.5:3b usa los ocho nucleos y va a ~12
# tokens/s; dos a la vez no van a 12 cada una sino a ~5, porque lo que se satura
# es el ancho de banda a la RAM. El trabajo total BAJA. Por eso el aforo es uno:
# no es una limitacion, es lo que mas saca de esta maquina.
IA_AFORO_GENERACION=1
# Tope duro de cuantos pueden estar esperando a la vez. Es un limite de hilos y
# memoria, no de paciencia: de la paciencia se encarga el presupuesto de abajo.
# Ocho y no tres: con tres, la sala se llenaba cuando la espera estimada era
# de solo 6 s —un 20% del presupuesto de 30— y rechazaba a gente que cabia
# de sobra, dejando sin efecto la estimacion medida.
IA_SALA_GENERACION=8
# EL PRESUPUESTO DE ESPERA. Si lo que se estima que va a esperar quien llega
# rebasa esto, no entra a la cola: se le dice que no en el acto, en cero
# segundos, y el portal sigue sin esa ayuda.
#
# La regla detras: O SE SIRVE PRONTO, O SE DICE QUE NO PRONTO. Nunca esperar y
# luego fallar, que es pagar el costo de la cola sin llevarse nada.
#
# Esto se intento primero con un plazo fijo y fallo dos veces por lo mismo: un
# plazo fijo no sabe cuanto tarda una generacion, y una generacion no tarda
# siempre lo mismo. Medido aqui (Ryzen 7 Pro, sin GPU, qwen2.5:3b,
# num_predict=400), la misma consulta tardo 14 s una vez y 20.7 s la siguiente.
# Con el plazo en 8 s se rendian todos justo antes de que les tocara; subido a
# 20 s, la generacion de 20.7 s volvio a dejar a alguien esperando en balde.
# Cualquier constante la gana una generacion lenta.
#
# Ahora la compuerta mide lo que tardan las generaciones de verdad y estima.
# Este numero dejo de ser un cronometro: es la pregunta "cuanto vale la pena
# esperar por una ayuda opcional que sale mientras se llena un formulario".
# Treinta segundos es generoso; mas alla, la persona ya envio el ticket.
IA_ESPERA_MAXIMA_GENERACION=30
# Cuanto se supone que tarda una generacion mientras no haya ninguna medida
# (los primeros segundos tras un reinicio). Luego manda lo medido.
# Cuatro y no quince: medido en la ruta real, normalizar tarda 1.50 s y
# clasificar 0.95 s. Solo se usa hasta que termina la primera generacion.
IA_DURACION_INICIAL_GENERACION=4

# Los embeddings son otra cosa: ~80 ms contra ~4 s. Van en su propia cola para
# que una busqueda por similitud no quede atrapada detras de una redaccion —la
# parte del portal que escala bien no tiene por que heredar la latencia de la
# que no—.
IA_AFORO_EMBEDDING=2
IA_SALA_EMBEDDING=8
IA_ESPERA_MAXIMA_EMBEDDING=3

# --- Grafo de conciencia: la traza en vivo del razonamiento ---
# Es decorativo: ensena por donde va una consulta mientras va. Perder un paso
# degrada la animacion, nunca la respuesta, que viaja por su HTTP de siempre.
TRAZA_COLA_MAXIMA=64
# Cada cuanto se manda un ping si no pasa nada. Sin esto, un intermediario que
# no ve trafico da la conexion por muerta y la corta.
TRAZA_LATIDO_SEGUNDOS=20
# Cuanto se espera el token en el primer mensaje del WebSocket. Corto a
# proposito: una conexion que se abre y no se identifica no ocupa sitio.
TRAZA_ESPERA_AUTENTICACION=10

# --- Limite de intentos de inicio de sesion ---
# Frena la prueba de contrasenas. Dos frenos: por cuenta y por IP. Solo cuentan
# los fallos. El de IP es mas alto porque, por el acceso directo, Docker
# presenta a todos los clientes con la misma IP (la de su puerta de enlace):
# "una IP" puede ser la planta entera.
LOGIN_MAX_INTENTOS=8
LOGIN_MAX_INTENTOS_POR_IP=40
LOGIN_VENTANA_SEGUNDOS=300
# El mismo freno para la activacion de cuenta (fechas, EPP, codigos). El bloqueo
# definitivo de la via por datos personales es ACTIVACION_MAX_INTENTOS.
ACTIVACION_FRENO_POR_CUENTA=6
ACTIVACION_FRENO_POR_IP=30
ACTIVACION_FRENO_VENTANA_SEGUNDOS=600

# --- Tamaño de lo que se recibe ---
# Tope de un cuerpo JSON (todo lo que no es subida de archivo), en KB. NGINX deja
# pasar 20 MB para los archivos; un JSON de ese tamaño son cientos de MB de RAM.
CUERPO_JSON_MAX_KB=1024
# Filas de un CSV de importacion de personal. Cada alta cifra su codigo con
# bcrypt: sin tope, un archivo grande ocupa el servidor horas.
IMPORTACION_MAX_FILAS=1000
# Consultas a la IA por persona y minuto. Escribir un ticket dispara tres por
# pausa; el tope es para que un script no deje a la planta sin asistente.
IA_PETICIONES_POR_MINUTO=60

# --- Documentos del expediente ---
# Resguardos firmados escaneados, responsivas, politicas. Van a disco.
DOCUMENTOS_RUTA=/app/documentos
DOCUMENTOS_MAX_MB=20

# --- Cuentas de acceso ---
# Dominios aceptados al dar de alta. Vacio = sin restriccion.
DOMINIOS_PERMITIDOS=cgr.mx
# Cuanto vive el codigo de activacion (168 h = 7 dias).
CODIGO_ACTIVACION_HORAS=168
PASSWORD_MIN_LONGITUD=10
# Cuantos datos personales hay que acertar para activar sin codigo. Con 1, quien
# vea la lista de RH puede activar cuentas ajenas; con 2 tiene que conocer dos
# cosas distintas de esa persona. Si la cuenta solo tiene uno, se exige ese.
VERIFICACION_FACTORES=2
# La activacion asistida se gasta en el mostrador, con la persona enfrente:
# dura minutos a proposito, no es un codigo para entregar.
ACTIVACION_ASISTIDA_MINUTOS=20
# Fallos seguidos con datos personales antes de cerrar esa via para la cuenta.
# Despues solo entra con un codigo de TI. Con 5 tiros contra ~17 000 fechas de
# nacimiento posibles, adivinar deja de ser una estrategia.
ACTIVACION_MAX_INTENTOS=5

# --- Siembra: la planta y su primer administrador ---
# Solo los lee `python seed.py`, una vez, al instalar. Si la planta o el
# administrador ya existen no se tocan, asi que cambiarlos aqui despues no hace
# nada: se editan desde el portal.
#
# La clave va en los folios (TICK-QRO-2026-0001). seed_temas.py usa la misma.
SEED_SITIO_CLAVE=QRO
SEED_SITIO_NOMBRE=Planta Querétaro
SEED_SITIO_PAIS=México
# Con el numero entra al portal; el correo es opcional, como en cualquier alta.
SEED_ADMIN_NUMERO=10001
SEED_ADMIN_NOMBRE=Administrador de TI
SEED_ADMIN_EMAIL=
# Vacia = se genera una al azar y se imprime una sola vez en la consola.
# Si se pone, tiene que cumplir la politica (PASSWORD_MIN_LONGITUD y demas).
SEED_ADMIN_PASSWORD=

# --- TLS ---
# nginx sirve por HTTPS en cuanto encuentra el certificado en nginx/certs.
# Para generarlo:
#     ./scripts/generar-certificado.sh portal.cgr.local 192.168.1.50
# Sin certificado el portal arranca en HTTP y las contrasenas viajan en claro.
#
# auto = HTTPS si hay certificado (lo normal).
# off  = HTTP siempre. El interruptor de marcha atras: un certificado
#        autofirmado hace que el navegador avise, y si eso pasa el primer dia
#        que entran 300 personas, todas concluyen que el portal no sirve.
TLS_ACTIVO=auto

# --- Redis (2026-10-02) ---
# Limitadores compartidos, sesiones revocables, avisos en vivo entre procesos
# y la cola del worker. docker-compose arma REDIS_URL con esta contraseña.
# Genérela con:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=
# Minutos antes del vencimiento del SLA en que se avisa a TI.
SLA_AVISO_MINUTOS=60
# Una calificación de la atención igual o menor abre una alerta.
SATISFACCION_ALERTA_MAXIMA=2

# --- Sensores ESP32 por MQTT (2026-10-02) ---
# La cuenta con la que el receptor del portal lee del broker...
MQTT_USUARIO=portal
MQTT_PASSWORD=
# ...y la que se graba en los ESP32 (solo puede publicar telemetría).
MQTT_DISPOSITIVO_USUARIO=sensor
MQTT_DISPOSITIVO_PASSWORD=
# Dónde escucha el broker hacia fuera. Por defecto solo en el servidor; para
# que lleguen los ESP32 de la red de planta, la IP del servidor en esa red:
#   MQTT_PUBLICAR=192.168.1.168:1883
MQTT_PUBLICAR=127.0.0.1:1883
# Lecturas más seguidas que esto (segundos), del mismo equipo, se descartan.
IOT_INTERVALO_MINIMO_S=5
IOT_RETENCION_DIAS=90
IOT_SIN_SENAL_MINUTOS=10
# Tope de equipos que se registran solos (la contraseña de los sensores es compartida).
IOT_MAX_DISPOSITIVOS=200
# Umbrales generales; cada sensor puede tener los suyos desde Monitoreo ESP32.
IOT_TEMPERATURA_MAX=35
IOT_HUMEDAD_MAX=70
IOT_CALIDAD_AIRE_MAX=1000
